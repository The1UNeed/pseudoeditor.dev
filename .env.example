# Copy to apps/web/.env.local for local development. Never commit real values.

# Clerk (https://dashboard.clerk.com) - leave both empty to run without accounts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (https://dashboard.convex.dev) - set by `npx convex dev` automatically.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Set on the Convex deployment (not here):
#   CLERK_JWT_ISSUER_DOMAIN  - the Frontend API URL of your Clerk app, e.g. https://clerk.pseudoeditor.dev
#   CLERK_WEBHOOK_SECRET     - signing secret of the Clerk webhook pointing at <convex-site-url>/clerk/webhook
